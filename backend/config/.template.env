APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
EXPOSE_INTERNAL_ERRORS=false
LINK_TOKEN_TTL_SECONDS=86400
DB_HOST=localhost
DB_PORT=3306
DB_NAME=footballhub
DB_USER=footballuser
DB_PASSWORD=footballpass
DB_PROVIDER=mysql+pymysql

# Consumed by the MySQL container (docker/docker-compose.yml -> env_file).
# The mysql:8 image reads these native names at init to create the database
# and the application user. Keep them in sync with DB_NAME/DB_USER/DB_PASSWORD.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=footballhub
MYSQL_USER=footballuser
MYSQL_PASSWORD=footballpass
